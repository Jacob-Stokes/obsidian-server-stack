# Official Obsidian Sync — see README.md in this folder for the one-time
# login step needed to get OBSIDIAN_AUTH_TOKEN.

# Running more than one instance on this machine? Set this to the same
# value as the root .env's INSTANCE_PREFIX — see the comment there.
INSTANCE_PREFIX=

OBSIDIAN_AUTH_TOKEN=
VAULT_NAME="My Vault"
VAULT_HOST_PATH=../../vault

# Only if your vault has end-to-end encryption enabled (Settings → Sync in
# the Obsidian app). This is the vault's own encryption password, not your
# Obsidian account password.
VAULT_PASSWORD=

# Optional — shown in Obsidian's sync device history.
DEVICE_NAME=obsidian-server-stack

# Self-hosted LiveSync — CouchDB environment
# Copy to .env in this directory and fill in real values. Never commit .env.

# Running more than one instance on this machine? Set this to the same
# value as the root .env's INSTANCE_PREFIX — see the comment there.
INSTANCE_PREFIX=

# Required
COUCHDB_USER=admin
COUCHDB_PASSWORD=change_me_use_a_strong_password
COUCHDB_DATABASE=obsidiannotes
COUCHDB_PORT=5984

# Where the synced vault's real markdown files land. Point this at the same
# folder as the root docker-compose.yml's VAULT_HOST_PATH (default: the root
# ./vault) so obsidian-api/obsidian-mcp see what gets synced here.
VAULT_HOST_PATH=../../vault

# Only if you turned on end-to-end encryption in the Self-hosted LiveSync
# plugin (Settings → the encryption passphrase you chose there).
VAULT_ENCRYPT_PASSPHRASE=

# --profile caddy (public domain + auto TLS)
COUCHDB_DOMAIN=couchdb.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --profile tailscale (no domain needed)
# OAuth key from https://login.tailscale.com/admin/settings/oauth (scope: devices:write)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_HOSTNAME=livesync

# --profile cloudflare (Cloudflare account + tunnel)
# Token from Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
CF_TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

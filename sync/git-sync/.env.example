# Running more than one instance on this machine? Set this to the same
# value as the root .env's INSTANCE_PREFIX.
INSTANCE_PREFIX=

# The repo your vault lives in. SSH (recommended — install.sh generates a
# deploy key for you) or HTTPS with a token:
#   git@github.com:you/vault.git
#   https://<token>@github.com/you/vault.git
GIT_REPO_URL=
GIT_BRANCH=main

# How often to commit, pull and push, in seconds.
SYNC_INTERVAL=60

# Name/email on commits made by the server.
GIT_AUTHOR_NAME=obsidian-server-stack
GIT_AUTHOR_EMAIL=obsidian-server-stack@localhost

# Same folder the root docker-compose.yml mounts into obsidian-api.
VAULT_HOST_PATH=../../vault

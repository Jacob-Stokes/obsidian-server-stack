# Shared CouchDB for every vault that uses self-hosted LiveSync. install.sh
# creates .env from this and generates the password. Never commit .env.

# Same value as the root .env's INSTANCE_PREFIX (install.sh copies it).
INSTANCE_PREFIX=
STACK_ID=

COUCHDB_USER=admin
COUCHDB_PASSWORD=
# Where CouchDB listens: this machine only by default. `obsidian-stack address`
# sets it (e.g. 0.0.0.0:5984 for the home network, or the Tailscale address).
COUCHDB_PORT=127.0.0.1:5984
# The address devices use, put into their Setup URIs. Phones need https://.
COUCHDB_DEVICE_URL=
# The HTTPS port `tailscale serve` uses, when the address step set that up
TS_SERVE_PORT=

# --profile caddy (public domain + auto TLS)
COUCHDB_DOMAIN=couchdb.example.com
ACME_EMAIL=you@example.com

# --profile tailscale (no domain needed)
# Auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=livesync

# --profile cloudflare (Cloudflare account + tunnel)
# Token from Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
CF_TUNNEL_TOKEN=

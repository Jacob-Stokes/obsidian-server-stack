#!/usr/bin/env bash
# obsidian-stack — set up and manage an obsidian-server-stack install: its
# vaults, their sync, status and logs.
#
# It only ever acts on the install it belongs to: the folder it lives in
# (following symlinks, so a copy linked onto PATH still knows its home), or
# one given with --dir / $OBSIDIAN_STACK_DIR. Containers are found by the
# Docker label obsidian-server-stack.id=<STACK_ID from .env>, never by name,
# so other Obsidian containers on the same machine are never touched.
set -euo pipefail

# --- look and feel -------------------------------------------------------------
#
# One style throughout: "◆ Heading" sections, "✓ / ! / ✗" status lines,
# "? question" prompts, everything else indented two spaces. Long-running
# steps show a spinner with the elapsed time and the step's latest output
# line; image downloads show a progress bar. Colour and animation only on a
# terminal (and not with NO_COLOR); piped or logged output stays plain.

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  TTY=1
  C_ACC=$'\033[38;5;141m' C_B=$'\033[1m' C_DIM=$'\033[2m' C_0=$'\033[0m'
  C_OK=$'\033[38;5;78m' C_WARN=$'\033[38;5;221m' C_ERR=$'\033[38;5;203m'
else
  TTY="" C_ACC="" C_B="" C_DIM="" C_0="" C_OK="" C_WARN="" C_ERR=""
fi
case "$(locale charmap 2>/dev/null)" in UTF-8) SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) ;; *) SPIN=('|' '/' '-' '\') ;; esac
[ -n "$TTY" ] && trap 'printf "\033[?25h"' EXIT

say()  { printf '\n%s◆%s %s%s%s\n' "$C_ACC" "$C_0" "$C_B" "$1" "$C_0"; }
ok()   { printf '  %s✓%s %s\n' "$C_OK" "$C_0" "$1"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_0" "$1"; }
fail() { printf '  %s✗%s %s\n' "$C_ERR" "$C_0" "$1"; }
info() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_0"; }
die()  { printf '\n  %s✗ %s%s\n' "$C_ERR" "$1" "$C_0" >&2; exit 1; }
# para: an explanation from a heredoc, set off by a blank line
para() { echo; sed "s/^/  /"; }

# Answers given as options (--name Work, --source livesync, ...), by key;
# see parse_opts. With --yes, a question with no answer given takes its
# default instead of being asked.
declare -A PRESET=()
NONINTERACTIVE=""
JSON=""

# ask "Question" VAR [KEY] — "? Question" (on stderr, like read -p, so it
# never ends up in a $(...) capture); end of input counts as an empty
# answer rather than exiting under set -e. Leading spaces in the question
# are ignored, so every prompt lines up the same. With KEY, an answer given
# as an option is used (and shown) instead of asking.
ask() {
  local q="${1#"${1%%[![:space:]]*}"}" key="${3:-}"
  if [ -n "$key" ] && [ -n "${PRESET[$key]+set}" ]; then
    printf -v "$2" '%s' "${PRESET[$key]}"
    printf '  %s?%s %s%s%s%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "${PRESET[$key]}" "$C_0" >&2
    return 0
  fi
  if [ -n "$NONINTERACTIVE" ]; then
    printf -v "$2" '%s' ""
    printf '  %s?%s %s%s(default)%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "$C_0" >&2
    return 0
  fi
  read -rp "  ${C_ACC}?${C_0} ${q}" "$2" || printf -v "$2" '%s' ""
}
# ask_secret "Question" VAR [ENV] — hidden input; with ENV, taken from that
# environment variable instead (secrets never go in options, which show up
# in process lists and shell history).
ask_secret() {
  local q="${1#"${1%%[![:space:]]*}"}" env="${3:-}"
  if [ -n "$env" ] && [ -n "${!env+set}" ]; then
    printf -v "$2" '%s' "${!env}"
    printf '  %s?%s %s%s(from $%s)%s\n' "$C_ACC" "$C_0" "$q" "$C_DIM" "$env" "$C_0" >&2
    return 0
  fi
  if [ -n "$NONINTERACTIVE" ]; then
    printf -v "$2" '%s' ""
    return 0
  fi
  read -rsp "  ${C_ACC}?${C_0} ${q}" "$2" || printf -v "$2" '%s' ""
  echo
}
# need KEY "what" — a value that has no default, when not asking
need() { [ -z "$NONINTERACTIVE" ] || [ -n "${PRESET[$1]:-}" ] || die "$2 is needed: --$1 <value>"; }
# interactive_only "what" — a step that can't be done without a person
interactive_only() { [ -z "$NONINTERACTIVE" ] || die "$1"; }

elapsed() { local t="$1"; if [ "$t" -ge 60 ]; then printf '%dm %02ds' $((t / 60)) $((t % 60)); else printf '%ds' "$t"; fi; }

# step "Label" COMMAND... — runs COMMAND with its output in the log, showing
# a spinner, the time so far and the command's latest output line, then
# "✓ Label (12s)". On failure, the last lines of output and the log's path.
step() {
  local label="$1"; shift
  local start=$SECONDS pid rc=0 i=0 last cols room
  mkdir -p "$(dirname "$LOG")"
  printf '\n=== %s  %s\n$ %s\n' "$(date '+%F %T')" "$label" "$*" >> "$LOG"
  if [ -z "$TTY" ]; then
    printf '  … %s\n' "$label"
    "$@" >> "$LOG" 2>&1 </dev/null || rc=$?
  else
    "$@" >> "$LOG" 2>&1 </dev/null &
    pid=$!
    printf '\033[?25l'
    while kill -0 "$pid" 2>/dev/null; do
      cols=$(tput cols 2>/dev/null || echo 80)
      last="$(tail -n 1 "$LOG" 2>/dev/null | tr -d '\r' | sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/^[[:space:]]*//')"
      room=$(( cols - ${#label} - 16 ))
      [ "$room" -gt 10 ] || last=""
      [ "${#last}" -gt "$room" ] && last="${last:0:$((room - 1))}…"
      printf '\r\033[K  %s%s%s %s  %s%s  %s%s' "$C_ACC" "${SPIN[i++ % ${#SPIN[@]}]}" "$C_0" "$label" \
        "$C_DIM" "$(elapsed $((SECONDS - start)))" "$last" "$C_0"
      sleep 0.12
    done
    wait "$pid" || rc=$?
    printf '\r\033[K\033[?25h'
  fi
  if [ "$rc" -eq 0 ]; then
    ok "$label ${C_DIM}($(elapsed $((SECONDS - start))))${C_0}"
  else
    fail "$label"
    tail -n 12 "$LOG" | sed "s/^/    ${C_DIM}/; s/\$/${C_0}/"
    info "Full log: $LOG"
  fi
  return "$rc"
}

# pull IMAGE "Label" — download an image with a progress bar (percent, MB,
# time), read from Docker's own pull progress. The total comes from the
# image's manifest when the registry provides it, else from the layers as
# they're announced. Falls back to a spinner without the Docker socket.
pull() {
  local image="$1" label="$2" start=$SECONDS total=0 arch rc=0
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  local sock="${DOCKER_HOST:-unix:///var/run/docker.sock}"; sock="${sock#unix://}"
  if [ -z "$TTY" ] || [ ! -S "$sock" ] || [ ! -w "$sock" ]; then
    step "Downloading $label" docker pull "$image"; return
  fi
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch="" ;; esac
  printf '  %s%s%s Downloading %s  %schecking size…%s' "$C_ACC" "${SPIN[0]}" "$C_0" "$label" "$C_DIM" "$C_0"
  if [ -n "$arch" ]; then
    total="$(timeout 20 docker manifest inspect -v "$image" 2>/dev/null | awk -v a="\"architecture\": \"$arch\"" '
      index($0, a) {f=1} f && /"layers"/ {l=1} l && /"size"/ {gsub(/[^0-9]/, ""); s += $0} l && /\]/ {print s+0; exit}')"
  fi
  printf '\033[?25l'
  local repo="${image%:*}" tag="${image##*:}"
  curl -sN --unix-socket "$sock" -X POST "http://localhost/images/create?fromImage=$repo&tag=$tag" 2>>"$LOG" \
    | tee -a "$LOG" | awk $AWK_LIVE -v total="${total:-0}" -v label="$label" -v acc="$C_ACC" -v dim="$C_DIM" -v reset="$C_0" -v t0="$(date +%s)" '
      function field(name,   m) { if (match($0, "\"" name "\":[0-9]+")) { m = substr($0, RSTART, RLENGTH); sub(/.*:/, "", m); return m + 0 } return -1 }
      function draw(   got, all, pct, n, bar, i, el, phase) {
        got = 0; all = 0
        for (k in tot) { all += tot[k]; got += (k in cur ? cur[k] : 0) }
        if (total > all) all = total
        pct = all > 0 ? int(got * 100 / all) : 0; if (pct > 100) pct = 100
        n = int(pct * 28 / 100); bar = ""
        for (i = 0; i < 28; i++) bar = bar (i < n ? "█" : "░")
        el = systime() - t0; phase = (pct >= 100 || unpacking) ? "unpacking…" : sprintf("%.0f / %.0f MB", got / 1e6, all / 1e6)
        printf "\r\033[K  %s%s%s Downloading %s  %s%s%s %3d%%  %s%s  %d:%02d%s", acc, spin[f++ % 10], reset, label, acc, bar, reset, pct, dim, phase, int(el / 60), el % 60, reset > "/dev/stderr"
        fflush("/dev/stderr")
      }
      BEGIN { split("⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏", spin, " "); f = 0 }
      /"error"/ { err = $0; next }
      {
        id = ""; if (match($0, /"id":"[^"]+"/)) { id = substr($0, RSTART + 6, RLENGTH - 7) }
        c = field("current"); t = field("total")
        if ($0 ~ /"status":"Downloading"/ && t > 0) { tot[id] = t; cur[id] = c }
        else if ($0 ~ /"status":"(Download complete|Pull complete|Already exists)"/ && id in tot) { cur[id] = tot[id] }
        else if ($0 ~ /"status":"Extracting"/) { unpacking = 1 }
        if (++lines % 5 == 0) draw()
      }
      END { draw(); printf "\r\033[K" > "/dev/stderr"; fflush("/dev/stderr"); if (err != "") { print err > "/dev/stderr"; exit 1 } }' || rc=$?
  printf '\033[?25h'
  if [ "$rc" -eq 0 ] && docker image inspect "$image" >/dev/null 2>&1; then
    ok "Downloaded $label ${C_DIM}($(awk -v b="${total:-0}" 'BEGIN { if (b > 0) printf "%.1f GB, ", b / 1e9 }')$(elapsed $((SECONDS - start))))${C_0}"
  else
    fail "Couldn't download $label ($image)"; info "Details in $LOG"; return 1
  fi
}

# mawk reads piped input in large blocks unless told not to, which would hold
# the progress bar back until the download had finished.
AWK_LIVE=""; awk -W version 2>/dev/null | grep -qi mawk && AWK_LIVE="-W interactive"

# The logo: a two-tone diamond with sync arrows, as in the README.
banner() {
  [ -n "$TTY" ] || { printf '\nobsidian-server-stack\n'; return; }
  local L1=$'\033[38;5;141m' R1=$'\033[38;5;135m' L2=$'\033[38;5;98m' R2=$'\033[38;5;56m'
  local W1=$'\033[1;97;48;5;141m' X1=$'\033[1;97;48;5;135m' W2=$'\033[1;97;48;5;98m' X2=$'\033[1;97;48;5;56m'
  local t="$C_B" d="$C_DIM" o="$C_0"
  printf '\n'
  printf '            %s▟%s▙%s\n'                         "$L1" "$R1" "$o"
  printf '           %s▟█%s█▙%s\n'                        "$L1" "$R1" "$o"
  printf '          %s▟██%s██▙%s\n'                       "$L1" "$R1" "$o"
  printf '         %s▟█%s╭─%s→╮%s█▙%s     %sobsidian-server-stack%s\n' "$L1" "$W1" "$X1" "$R1" "$o" "$t" "$o"
  printf '        %s███%s↑ %s ↓%s███%s    %sObsidian vaults on a server,%s\n' "$L2" "$W2" "$X2" "$R2" "$o" "$d" "$o"
  printf '         %s▜█%s╰←%s─╯%s█▛%s     %ssynced and reachable over MCP%s\n' "$L2" "$W2" "$X2" "$R2" "$o" "$d" "$o"
  printf '          %s▜██%s██▛%s\n'                       "$L2" "$R2" "$o"
  printf '           %s▜█%s█▛%s\n'                        "$L2" "$R2" "$o"
  printf '            %s▜%s▛%s\n'                         "$L2" "$R2" "$o"
}

usage() {
  cat <<'EOF'
Usage: obsidian-stack [--dir PATH] [command]

  (no command)        interactive menu
  install             first-time setup, or re-run to repair/rebuild
  status              core containers and each vault's sync
  vaults              list vaults
  add                 add a vault (scripted: see "Without questions" below)
  rename ID NAME      change a vault's display name (its id stays)
  remove [ID]         remove a vault (its files are kept)
  setup-uri [ID] [--url]
                      Setup URI for a self-hosted LiveSync vault's devices
                      (--url: change the address devices connect to)
  logs TARGET [-f]    logs for a vault id, app:ID, or api | mcp | couchdb
  restart TARGET      restart a vault's sync, app:ID, api | mcp | couchdb, or all
  app [status]        optional Obsidian app add-on, per vault:
  app enable|disable ID
  app run ID COMMAND  run an Obsidian CLI command in a vault's app
  update              git pull, rebuild and restart everything
  uninstall [--yes]   remove this install's containers, images and command;
                      notes are kept unless asked (--yes: no prompts, keep data)
  endpoint [--show-token]
                      MCP URL and bearer token
  manager [status]    optional: let AI tools manage this install (opt-in):
  manager enable|disable
  licenses [--full]   licences of the stack and what it uses (--full: texts)
  link [NAME]         put this install's obsidian-stack on PATH
                      (/usr/local/bin/NAME, default obsidian-stack)

The install it acts on: --dir, else $OBSIDIAN_STACK_DIR, else the folder
this script lives in.

Without questions: --yes answers every question with its default, and
these options answer specific ones:
  --name NAME  --source livesync|existing-livesync|official|git|none
  --device-url URL  --git-repo URL  --official-vault NAME  --reuse-login yes|no
  --app yes|no  --app-port N  --plugins yes|no (restricted mode off)
  --settings-sync yes|no  --plugin-changes yes|no
Secrets come from the environment, never options: OBSIDIAN_VAULT_PASSWORD,
LIVESYNC_SETUP_URI, LIVESYNC_SETUP_PASSPHRASE.
--json: machine-readable output from status, vaults and setup-uri.
e.g. obsidian-stack add --yes --name Work --source livesync --device-url https://couch.example.com
EOF
}

# --- which install -----------------------------------------------------------

DIR=""
if [ "${1:-}" = "--dir" ]; then DIR="${2:?--dir needs a path}"; shift 2; fi
DIR="${DIR:-${OBSIDIAN_STACK_DIR:-}}"
[ -n "$DIR" ] || DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "$DIR/docker-compose.yml" ] && [ -d "$DIR/services/obsidian-api" ] \
  || die "$DIR is not an obsidian-server-stack folder (use --dir)"
cd "$DIR"
ROOT="$(pwd)"
# Output of every step, for when something fails. state/ is private (0700).
LOG="$ROOT/state/obsidian-stack.log"
P=""
STACK_ID=""
LABEL=obsidian-server-stack
ME="$0"
[ "$(command -v "$(basename "$0")" 2>/dev/null)" = "$0" ] && ME="$(basename "$0")"
COUCHDB_READY=""

load_env() {
  # shellcheck disable=SC1091
  [ -f .env ] && source .env
  P="${INSTANCE_PREFIX:-}"
  STACK_ID="${STACK_ID:-}"
  # The MCP is checked at localhost, except from inside the manager add-on
  MCP_HEALTH="${OBSIDIAN_MCP_HEALTH_URL:-http://localhost:${MCP_PORT:-7002}/health}"
}

require_installed() {
  load_env
  [ -n "$STACK_ID" ] && docker image inspect "${P}obsidian-api:local" >/dev/null 2>&1 \
    || die "this install isn't set up yet — run: $ME install"
}

# own [-R] PATH — chown to the containers' uid/gid
own() {
  if ! chown "${@:1:$#-1}" 1000:1000 "${@: -1}" 2>/dev/null; then
    warn "Couldn't chown ${*: -1} to 1000:1000 (not root?). If writes fail later, run that chown yourself."
  fi
}

# The vault registry is managed by the same code the API reads it with, run
# inside the API image, so the host needs nothing beyond Docker.
reg() { docker run --rm -v "$ROOT/vaults:/vaults" -w /app --entrypoint node "${P}obsidian-api:local" registry.mjs /vaults "$@" </dev/null; }

# This install's containers, by label: ours <role> [vault]
ours() {
  local args=(--filter "label=$LABEL.id=$STACK_ID" --filter "label=$LABEL.role=$1")
  [ -n "${2:-}" ] && args+=(--filter "label=$LABEL.vault=$2")
  docker ps -a "${args[@]}" --format '{{.Names}}'
}

# "● running (Up 2 hours)" style one-liner for a container
dot() {
  local c="$1" state status health
  [ -n "$c" ] || { printf '%s○ not running%s' "$C_DIM" "$C_0"; return; }
  state="$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo missing)"
  status="$(docker ps -a --filter "name=^${c}$" --format '{{.Status}}')"
  health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$c" 2>/dev/null || true)"
  case "$state:$health" in
    running:unhealthy) printf '%s● unhealthy%s %s· %s%s' "$C_ERR" "$C_0" "$C_DIM" "$status" "$C_0" ;;
    running:*) printf '%s● running%s %s· %s%s' "$C_OK" "$C_0" "$C_DIM" "$status" "$C_0" ;;
    restarting:*) printf '%s● restarting%s %s· %s%s' "$C_ERR" "$C_0" "$C_DIM" "$status" "$C_0" ;;
    *) printf '%s● %s%s %s· %s%s' "$C_ERR" "$state" "$C_0" "$C_DIM" "$status" "$C_0" ;;
  esac
}

# --- vault setup (one function per sync source) ------------------------------

set_env() {
  # set_env FILE KEY VALUE [force] — replaces KEY= in FILE, only if currently
  # empty unless "force" is passed. Always quotes the written value: these
  # files get `source`d, so an unquoted value with a space breaks them — e.g.
  # a vault name like "My Vault" parses as VAULT_NAME=My, then tries to run
  # "Vault" as a command. Found by actually entering one, not by inspection.
  local file="$1" key="$2" val="$3" force="${4:-}"
  touch "$file"
  if grep -q "^${key}=" "$file"; then
    if [ -n "$force" ] || [ -z "$(grep "^${key}=" "$file" | cut -d= -f2-)" ]; then
      local tmp; tmp="$(mktemp)"
      # via ENVIRON, not awk -v, which would mangle backslashes in the value
      K="$key" V="\"$val\"" awk 'index($0, ENVIRON["K"]"=")==1 { print ENVIRON["K"]"="ENVIRON["V"]; next } { print }' "$file" > "$tmp"
      cat "$tmp" > "$file" && rm -f "$tmp"
    fi
  else
    echo "${key}=\"${val}\"" >> "$file"
  fi
}

# until_ok TRIES COMMAND... — retry every 2s; for use under step
until_ok() {
  local n="$1"; shift
  for _ in $(seq 1 "$n"); do "$@" >/dev/null 2>&1 && return 0; sleep 2; done
  return 1
}

# The image a compose file pins for a service, so pull() and compose agree.
compose_image() { awk -v svc="  $2:" '$0 == svc {f=1} f && /image:/ {print $2; exit}' "$1"; }

sync_dir() {
  case "$1" in
    livesync|livesync-existing) echo livesync ;;
    official) echo official-obsidian-sync ;;
    git) echo git-sync ;;
    *) echo "" ;;
  esac
}

source_label() {
  case "$1" in
    livesync) echo "self-hosted LiveSync" ;;
    livesync-existing) echo "existing LiveSync server" ;;
    official) echo "Official Obsidian Sync" ;;
    git) echo "git" ;;
    *) echo "no sync" ;;
  esac
}

vc() {
  local id="$1" dir; dir="$(sync_dir "$2")"; shift 2
  docker compose -p "${P}obsidian-${id}" --project-directory "sync/$dir" \
    -f "sync/$dir/docker-compose.yml" --env-file "state/$id/sync.env" "$@"
}

new_state() {
  local id="$1"
  mkdir -p "state/$id"
  chmod 700 "state/$id"
  local f="state/$id/sync.env" keep=""
  # A vault removed and added again keeps its self-hosted LiveSync keys:
  # its CouchDB database is still encrypted with them.
  [ -f "$f" ] && keep="$(grep -E '^(VAULT_ENCRYPT_PASSPHRASE|LIVESYNC_ID_RECOVERY_CODE)=' "$f" || true)"
  : > "$f"
  chmod 600 "$f"
  [ -n "$keep" ] && printf '%s\n' "$keep" >> "$f"
  set_env "$f" INSTANCE_PREFIX "$P"
  set_env "$f" STACK_ID "$STACK_ID"
  set_env "$f" VAULT_ID "$id"
  set_env "$f" VAULT_DIR "$ROOT/vaults/$id"
  set_env "$f" STATE_DIR "$ROOT/state/$id"
}

ensure_livesync_network() {
  docker network inspect "${P}obsidian-livesync" >/dev/null 2>&1 \
    || docker network create "${P}obsidian-livesync" >/dev/null
}

ensure_couchdb() {
  [ -n "$COUCHDB_READY" ] && return 0
  ( cd sync/couchdb
    [ -f .env ] || cp .env.example .env
    chmod 600 .env
    set_env .env INSTANCE_PREFIX "$P" force
    set_env .env STACK_ID "$STACK_ID" force
    # shellcheck disable=SC1091
    source .env
    if [ -z "${COUCHDB_PASSWORD:-}" ]; then
      set_env .env COUCHDB_PASSWORD "$(openssl rand -hex 20)"
      ok "Generated the CouchDB password ${C_DIM}(sync/couchdb/.env)${C_0}"
    fi
  )
  ensure_livesync_network
  pull "$(compose_image sync/couchdb/docker-compose.yml couchdb)" "CouchDB"
  step "Starting CouchDB" sh -c 'cd sync/couchdb && docker compose --progress plain up -d' \
    || die "CouchDB didn't start"
  # couchdb-init turns on auth and CORS; wait for it too, so a device can't
  # connect to a half-configured server.
  step "Waiting for CouchDB to be ready" until_ok 90 couchdb_ready \
    || die "CouchDB didn't come up — check: $ME logs couchdb"
  info "CouchDB listens on port $(grep '^COUCHDB_PORT=' sync/couchdb/.env | cut -d= -f2- | tr -d '"')"
  COUCHDB_READY=1
}

couchdb_ready() {
  [ "$(docker inspect -f '{{.State.Health.Status}}' "${P}obsidian-couchdb" 2>/dev/null)" = healthy ] &&
    [ "$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "${P}obsidian-couchdb-init" 2>/dev/null)" = "exited 0" ]
}

couchdb_env() { grep "^$1=" sync/couchdb/.env | cut -d= -f2- | tr -d '"'; }

create_db() {
  local code
  code="$(docker exec "${P}obsidian-couchdb" curl -s -o /dev/null -w '%{http_code}' \
    -u "$(couchdb_env COUCHDB_USER):$(couchdb_env COUCHDB_PASSWORD)" -X PUT "http://127.0.0.1:5984/$1")"
  case "$code" in
    201|202) ok "Created the CouchDB database '$1'" ;;
    412) ok "Reusing the existing CouchDB database '$1'" ;;
    *) die "couldn't create CouchDB database '$1' (HTTP $code)" ;;
  esac
}

setup_none() {
  ok "No sync: put files in vaults/$1/ however you like (rsync, Syncthing…)"
}

# --- Setup URIs (self-hosted LiveSync) ---------------------------------------
#
# Self-hosted LiveSync vaults are configured entirely by Setup URIs, made with
# the LiveSync project's own generator, so the server's worker and every
# device get identical settings: end-to-end encryption, path obfuscation and
# the vault's document-id key. Two URIs are made from the same settings, one
# with the CouchDB address as the worker sees it, one with the address
# devices use. The encryption passphrase and the id recovery code are kept in
# state/<id>/sync.env, so device URIs can be made again at any time.

# Pinned: the generator's Setup URI format has to match the CLI image's.
GEN_URL=https://raw.githubusercontent.com/vrtmrz/obsidian-livesync/0f6e32dc1b42e85b9d8884d54742706c88036a37/utils/flyio/generate_setupuri.ts
GEN_IMAGE=denoland/deno:2.4.5

# gen_uri ID HOSTNAME — runs the generator; sets URI, URI_PASS and RECOVERY
gen_uri() {
  local id="$1" host="$2" f="state/$1/sync.env" out vol="${P}obsidian-deno-cache"
  docker volume inspect "$vol" >/dev/null 2>&1 \
    || docker volume create --label "$LABEL.id=$STACK_ID" "$vol" >/dev/null
  pull "$GEN_IMAGE" "the Setup URI generator (Deno)" >&2
  # shellcheck disable=SC1090
  out="$( ( source "$f"
    docker run --rm -v "$vol:/deno-dir" -e DENO_DIR=/deno-dir \
      -e hostname="$host" -e username="$(couchdb_env COUCHDB_USER)" \
      -e password="$(couchdb_env COUCHDB_PASSWORD)" -e database="$id" \
      -e passphrase="${VAULT_ENCRYPT_PASSPHRASE:?no VAULT_ENCRYPT_PASSPHRASE in $f}" -e id_recovery_code="${LIVESYNC_ID_RECOVERY_CODE:-}" \
      -e uri_mode=persistent "$GEN_IMAGE" run -A "$GEN_URL" </dev/null 2>&1 ) )" \
    || { echo "$out" | tail -5 >&2; die "the Setup URI generator failed"; }
  URI="$(echo "$out" | grep -m1 '^obsidian://setuplivesync?settings=')"
  URI_PASS="$(echo "$out" | sed -n 's/^Your passphrase for the Setup URI is: //p')"
  RECOVERY="$(echo "$out" | sed -n 's/^ID recovery code: //p')"
  [ -n "$URI" ] && [ -n "$URI_PASS" ] || { echo "$out" | tail -5 >&2; die "unexpected output from the Setup URI generator"; }
}

worker_configured() {
  vc "$1" livesync run --rm -T --entrypoint sh livesync -c 'test -f /data/.livesync/settings.json' </dev/null >/dev/null 2>&1
}

# Configures the server's worker for a self-hosted vault from its own URI.
import_server_uri() {
  local id="$1" f="state/$1/sync.env"
  # shellcheck disable=SC1090
  [ -n "$(source "$f"; echo "${VAULT_ENCRYPT_PASSPHRASE:-}")" ] \
    || set_env "$f" VAULT_ENCRYPT_PASSPHRASE "$(openssl rand -base64 24 | tr '+/' '-_' | tr -d '=')"
  gen_uri "$id" "http://${P}obsidian-couchdb:5984"
  [ -n "$RECOVERY" ] && set_env "$f" LIVESYNC_ID_RECOVERY_CODE "$RECOVERY"
  printf '%s\n' "$URI_PASS" | vc "$id" livesync run --rm -T -e SETUP_URI="$URI" livesync setup >/dev/null 2>&1 \
    || die "couldn't configure the LiveSync worker for '$id'"
  ok "Configured the server's LiveSync client ${C_DIM}(end-to-end encrypted)${C_0}"
}

device_url() {
  local cur ans
  cur="$(couchdb_env COUCHDB_DEVICE_URL)"
  if [ -z "$cur" ] || [ -n "${1:-}" ]; then
    [ -n "$cur" ] || cur="http://$(hostname -I 2>/dev/null | awk '{print $1}'):$(couchdb_env COUCHDB_PORT)"
    para >&2 <<EOF
The address devices use to reach CouchDB goes into their Setup URI.
Desktop Obsidian accepts http://. Obsidian on iOS and Android only
connects over https://, even across Tailscale or a home network, so
phones need an HTTPS address: see "Phones and HTTPS" in the README.
${C_DIM}Change it later with: $ME setup-uri <vault> --url${C_0}
EOF
    echo >&2
    ask "Device address [$cur]: " ans device-url
    ( cd sync/couchdb && set_env .env COUCHDB_DEVICE_URL "${ans:-$cur}" force )
  fi
  couchdb_env COUCHDB_DEVICE_URL
}

# Prints a Setup URI for devices. Not stored: it can always be made again.
print_device_uri() {
  local id="$1" url="$2"
  gen_uri "$id" "$url"
  say "Setup URI for '$id'"
  info "Devices connect to $url"
  printf '\n%s\n\n' "$URI"
  printf '  %sPassphrase%s  %s%s%s\n' "$C_DIM" "$C_0" "$C_B" "$URI_PASS" "$C_0"
  para <<EOF
On each device: install the Self-hosted LiveSync plugin, choose
"Use the copied setup URI" (or open the URI on the device), and enter the
passphrase. Encryption and every other setting come from the URI.
${C_DIM}It doesn't expire and works on any number of devices. Another: $ME setup-uri $id${C_0}
EOF
  [[ "$url" == http://* ]] && warn "This address is http://, which Obsidian on phones refuses (desktop only)"
  return 0
}

setup_livesync() {
  local id="$1" f="state/$1/sync.env"
  ensure_couchdb
  create_db "$id"
  pull "$(compose_image sync/livesync/docker-compose.yml livesync)" "the LiveSync client"
  if worker_configured "$id"; then
    ok "Already configured, reusing existing settings"
  else
    import_server_uri "$id"
  fi
  step "Starting the LiveSync worker" vc "$id" livesync --progress plain up -d || die "the LiveSync worker didn't start"
  print_device_uri "$id" "$(device_url)"
}

cmd_setup_uri() {
  require_installed
  local id="${1:-}" change="${CHANGE_URL:-}" src name
  [ -n "$id" ] || { interactive_only "which vault: give its id"; vault_rows; echo; ask "  Vault id: " id; }
  src="$(reg list | awk -F'\t' -v id="$id" '$1==id {print $2}')"
  case "$src" in
    livesync) ;;
    livesync-existing) die "'$id' joins an existing LiveSync server; its Setup URI comes from that setup's plugin (Copy setup URI)" ;;
    "") die "no vault '$id'" ;;
    *) die "'$id' isn't a self-hosted LiveSync vault ($(source_label "$src")); only those have Setup URIs" ;;
  esac
  # shellcheck disable=SC1090
  [ -n "$(source "state/$id/sync.env"; echo "${LIVESYNC_ID_RECOVERY_CODE:-}")" ] \
    || die "'$id' was set up before Setup URIs existed; remove it and add it again"
  local url; url="$(device_url "$change")"
  if [ -n "$JSON" ]; then
    gen_uri "$id" "$url"
    printf '{"vault":%s,"url":%s,"uri":%s,"passphrase":%s}\n' "$(json_str "$id")" "$(json_str "$url")" "$(json_str "$URI")" "$(json_str "$URI_PASS")"
    return
  fi
  print_device_uri "$id" "$url"
}

setup_livesync_existing() {
  local id="$1" uri pass
  ensure_livesync_network
  # </dev/null: `docker compose run` otherwise reads stdin and swallows
  # whatever the user types next (found by testing with piped input).
  if vc "$id" livesync-existing run --rm -T --entrypoint sh livesync -c 'test -f /data/.livesync/settings.json' </dev/null >/dev/null 2>&1; then
    ok "Already connected, reusing existing settings"
  else
    para <<'EOF'
In Obsidian on a device that already syncs: Settings → Self-hosted LiveSync
→ Setup → Copy the setup URI. It asks you to choose a passphrase for it.
EOF
    echo
    ask_secret "Setup URI (hidden): " uri LIVESYNC_SETUP_URI
    [ -n "$uri" ] || die "a Setup URI is required (LIVESYNC_SETUP_URI)"
    ask_secret "  Its passphrase (hidden): " pass LIVESYNC_SETUP_PASSPHRASE
    [ -n "$pass" ] || die "the Setup URI passphrase is required (LIVESYNC_SETUP_PASSPHRASE)"
    # Used once and not stored: the URI goes in as an env var for this run
    # only, the passphrase on stdin. The CLI keeps the decoded settings in
    # the vault's own data volume.
    if ! printf '%s\n' "$pass" | vc "$id" livesync-existing run --rm -T -e SETUP_URI="$uri" livesync setup >/dev/null 2>&1; then
      die "couldn't apply that Setup URI — check the URI and passphrase, then re-run ./install.sh"
    fi
    ok "Settings imported from the Setup URI"
  fi
  pull "$(compose_image sync/livesync/docker-compose.yml livesync)" "the LiveSync client"
  step "Connecting to the existing LiveSync server" vc "$id" livesync-existing --progress plain up -d \
    || die "the LiveSync worker didn't start"
}

setup_official() {
  local id="$1" f="state/$1/sync.env" other token="" vn vp out again pick
  local data="state/$id/official" tokfile="state/$id/official/config/obsidian-headless/auth_token"
  mkdir -p "$data"
  own -R "$data"
  set_env "$f" DEVICE_NAME "obsidian-server-stack"
  step "Building the Obsidian Sync client" vc "$id" official --progress plain build \
    || die "couldn't build the Obsidian Sync client"

  # Reuse a login from another Official Sync vault on this server, if any.
  for other in state/*/official/config/obsidian-headless/auth_token; do
    [ -s "$other" ] && [ "$other" != "$tokfile" ] || continue
    ask "Use the Obsidian account already signed in on this server? [Y/n] " again reuse-login
    case "$again" in [nN]*) ;; *)
      mkdir -p "$(dirname "$tokfile")"
      cp "$other" "$tokfile"
      own -R "$data"
      token="$(cat "$tokfile")"
      ok "Reusing that login"
    ;; esac
    break
  done

  if [ -z "$token" ]; then
    interactive_only "no Obsidian account is signed in on this server to reuse; add an Official Sync vault interactively first ($ME add)"
    # The one step that can't be scripted: your Obsidian email, password and
    # MFA code have to be typed by you — a script that could do this for you
    # would need your raw account password sitting in a file.
    say "Sign in to Obsidian"
    info "Your Obsidian account email, password and (if on) 2FA code. Asked by Obsidian's own client."
    echo
    until vc "$id" official run --rm -it obsidian-sync get-token; do
      echo
      warn "Sign-in didn't work (the error above says why)."
      ask "Try again? [Y/n] " again
      case "$again" in [nN]*) die "Obsidian login cancelled" ;; esac
    done
    if [ -s "$tokfile" ]; then
      token="$(cat "$tokfile")"
    else
      ask "  Paste the OBSIDIAN_AUTH_TOKEN value printed above: " token
    fi
    [ -n "$token" ] || die "no token entered"
  fi
  set_env "$f" OBSIDIAN_AUTH_TOKEN "$token" force

  # Offer the vaults on the account; fall back to typing the name.
  local remote=()
  while IFS= read -r vn; do [ -n "$vn" ] && remote+=("$vn"); done < <(
    vc "$id" official run --rm -T obsidian-sync list-vaults </dev/null 2>/dev/null || true)
  vn="${PRESET[official-vault]:-}"
  if [ -n "$vn" ]; then
    if [ "${#remote[@]}" -gt 0 ] && ! printf '%s\n' "${remote[@]}" | grep -qxF "$vn"; then
      die "no vault named '$vn' on this Obsidian account (it has: $(printf '%s, ' "${remote[@]}" | sed 's/, $//'))"
    fi
    ok "Using '$vn' from the account"
  elif [ "${#remote[@]}" -eq 1 ]; then
    vn="${remote[0]}"
    ok "Found one vault on your account: $vn"
  elif [ "${#remote[@]}" -gt 1 ]; then
    need official-vault "which vault on the Obsidian account"
    echo
    info "Vaults on your account:"
    for i in "${!remote[@]}"; do printf '    %s%d%s  %s\n' "$C_ACC" "$((i + 1))" "$C_0" "${remote[$i]}"; done
    echo
    while [ -z "$vn" ]; do
      ask "  Which one? [1-${#remote[@]}] " pick
      if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "${#remote[@]}" ]; then
        vn="${remote[$((pick - 1))]}"
      fi
    done
  else
    need official-vault "the vault's name on the Obsidian account"
    warn "Couldn't list the vaults on your account, so type the name instead."
    ask "  Exact vault name on your Obsidian Sync account: " vn
  fi
  [ -n "$vn" ] || die "vault name is required"
  set_env "$f" VAULT_NAME "$vn" force

  # Link the vault here, not in the long-running container, so a wrong
  # encryption password gets asked again instead of a restart loop.
  if vc "$id" official run --rm -T obsidian-sync is-configured </dev/null >/dev/null 2>&1; then
    ok "Sync for '$vn' is already set up, reusing it"
  else
    ask_secret "  End-to-end encryption password (blank if you didn't turn that on): " vp OBSIDIAN_VAULT_PASSWORD
    # Passed by name (-e VAULT_PASSWORD), so it never shows up in `ps`.
    until out=$(VAULT_PASSWORD="$vp" vc "$id" official run --rm -T -e VAULT_PASSWORD obsidian-sync setup </dev/null 2>&1); do
      case "$out" in
        *"Wrong vault key"*)       warn "That encryption password isn't right for '$vn'." ;;
        *"Password not provided"*) warn "'$vn' has end-to-end encryption, so it needs its password." ;;
        *)
          echo "$out" | grep -v '^ *at \|Container ' | tail -5 | sed "s/^/    /"
          warn "Setting up sync didn't work (see above)."
          interactive_only "Obsidian Sync setup failed"
          ask "  Try again? [Y/n] " again
          case "$again" in [nN]*) die "Obsidian Sync setup cancelled" ;; esac
          continue ;;
      esac
      interactive_only "wrong or missing encryption password (OBSIDIAN_VAULT_PASSWORD)"
      info "It's the vault's encryption password, not your Obsidian account password."
      ask_secret "  Encryption password (blank to stop): " vp
      [ -n "$vp" ] || die "Obsidian Sync setup cancelled"
    done
    set_env "$f" VAULT_PASSWORD "$vp" force
    ok "Connected to '$vn'"
  fi
  step "Starting Obsidian Sync for '$vn'" vc "$id" official --progress plain up -d || die "Obsidian Sync didn't start"
}

setup_git() {
  local id="$1" f="state/$1/sync.env" repo
  para <<'EOF'
The vault's git repository. SSH (e.g. git@github.com:you/vault.git) is
recommended: a deploy key is generated for it. HTTPS works too, with a
token in the URL.
EOF
  echo
  need git-repo "the repository URL"
  ask "Repo URL: " repo git-repo
  [ -n "$repo" ] || die "a repo URL is required"
  set_env "$f" GIT_REPO_URL "$repo"
  set_env "$f" GIT_BRANCH main
  set_env "$f" SYNC_INTERVAL 60
  local ssh="state/$id/ssh"
  mkdir -p "$ssh"
  case "$repo" in
    http://*|https://*|file://*) ;;
    *)
      if [ ! -f "$ssh/id_ed25519" ]; then
        command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is required to create a deploy key"
        ssh-keygen -q -t ed25519 -N "" -f "$ssh/id_ed25519" -C "obsidian-server-stack/$id"
        para <<'EOF'
Add this public key to the repository as a deploy key, with write access
(GitHub: repo → Settings → Deploy keys → Add deploy key → Allow write access):
EOF
        printf '\n    %s%s%s\n\n' "$C_B" "$(cat "$ssh/id_ed25519.pub")" "$C_0"
        [ -n "$NONINTERACTIVE" ] && warn "Sync will fail until this deploy key is added to the repository." \
          || ask "Press Enter once it's added… " _
      fi
      ;;
  esac
  own -R "$ssh"
  chmod 600 "$ssh/id_ed25519" 2>/dev/null || true
  step "Building and starting git sync" vc "$id" git --progress plain up -d --build || die "git sync didn't start"
  info "Syncs every 60s; devices use the obsidian-git plugin on the same repository."
}


add_vault() {
  local name id choice src
  say "Add a vault"
  echo
  need name "a vault name"
  ask "Vault name (e.g. Personal, Work): " name name
  [ -n "$name" ] || { info "No name entered, nothing added."; return; }
  id="$(reg suggest-id "$name")"
  local g="$C_OK+$C_0" m="$C_WARN−$C_0"
  echo
  info "How should this vault's notes reach this server?"
  cat <<EOF

  ${C_ACC}1${C_0}  ${C_B}Self-hosted LiveSync${C_0}
       $g Free and real-time, end-to-end encrypted, everything on this server
       $m The Self-hosted LiveSync plugin on each device; phones need HTTPS

  ${C_ACC}2${C_0}  ${C_B}Existing LiveSync server${C_0}
       $g Joins a LiveSync setup already in use, settings unchanged
       $m Needs its Setup URI; writes go into that real vault (try a test vault)

  ${C_ACC}3${C_0}  ${C_B}Official Obsidian Sync${C_0}
       $g Easiest on devices: Obsidian's built-in Sync, real-time
       $m Needs an Obsidian Sync subscription and one sign-in here

  ${C_ACC}4${C_0}  ${C_B}Git${C_0}
       $g Free, full history, any git host
       $m Syncs every minute; edits on two devices in between can conflict

  ${C_ACC}5${C_0}  ${C_B}None${C_0}
       $g Nothing extra runs
       $m Keep vaults/$id/ up to date yourself (rsync, Syncthing…)

EOF
  ask "Choice [1]: " choice source
  case "${choice:-1}" in
    livesync|self-hosted|self-hosted-livesync) choice=1 ;;
    existing|existing-livesync|livesync-existing) choice=2 ;;
    official|obsidian-sync|official-sync) choice=3 ;;
    git) choice=4 ;;
    none) choice=5 ;;
  esac
  case "${choice:-1}" in
    1) src=livesync ;;
    2) src=livesync-existing ;;
    3) src=official ;;
    4) src=git ;;
    5) src=none ;;
    *) info "Not a choice, nothing added."; return ;;
  esac
  say "Setting up '$name' $(printf '%s(%s, id: %s)%s' "$C_DIM" "$(source_label "$src")" "$id" "$C_0")"
  # Values with no default, checked before anything is created, so a refused
  # add leaves nothing behind.
  [ "$src" = git ] && need git-repo "the repository URL"
  if [ "$src" = official ] && [ -n "$NONINTERACTIVE" ] && ! ls state/*/official/config/obsidian-headless/auth_token >/dev/null 2>&1; then
    die "no Obsidian account is signed in on this server to reuse; add an Official Sync vault interactively first ($ME add)"
  fi

  mkdir -p "vaults/$id"
  own "vaults/$id"
  new_state "$id"
  case "$src" in
    livesync) setup_livesync "$id" ;;
    livesync-existing) setup_livesync_existing "$id" ;;
    official) setup_official "$id" ;;
    git) setup_git "$id" ;;
    none) setup_none "$id" ;;
  esac
  # Registered last, so a vault only appears to MCP clients once its sync
  # is set up.
  reg add "$id" "$src" "$name"
  ok "Added '$name' ${C_DIM}(files in vaults/$id/)${C_0}"

  local app
  say "Obsidian app ${C_DIM}(optional)${C_0}"
  para <<EOF
Everything so far works on plain files. The full Obsidian app, running on
this server, adds what only Obsidian can do: AI tools can run community
plugins (Templater, Linter…), query Bases, find broken links and take
screenshots of notes, and the vault opens in a browser tab.
${C_DIM}About 350 MB of RAM and a 1.3 GB download. More: "Obsidian app" in README.md${C_0}
EOF
  echo
  ask "Add the Obsidian app for '$name'? [y/N] " app app
  case "$app" in
    [yY]*) app_enable "$id" ;;
    *) info "Skipped. Later: $ME app enable $id" ;;
  esac
}

remove_vault() {
  local id="${1:-}" src confirm
  [ -n "$id" ] || { interactive_only "which vault: $ME remove <id>"; ask "Id of the vault to remove: " id; }
  src="$(reg list | awk -F'\t' -v i="$id" '$1==i { print $2 }')"
  [ -n "$src" ] || { info "No vault with id '$id'."; return; }
  ask "Remove '$id' from the stack? Its files stay in vaults/$id/. [y/N] " confirm confirm
  case "$confirm" in [yY]*) ;; *) info "Kept it."; return ;; esac
  if [ -n "$(sync_dir "$src")" ] && [ -f "state/$id/sync.env" ]; then
    vc "$id" "$src" down -v --remove-orphans >/dev/null 2>&1 || true
  fi
  if app_on "$id" && [ -f "state/$id/app.env" ]; then
    ac "$id" down -v --remove-orphans >/dev/null 2>&1 || true
  fi
  reg remove "$id"
  ok "Removed '$id'"
  info "Its notes are still in vaults/$id/ and its settings in state/$id/; delete them once sure."
}

ensure_all_up() {
  local id src name
  while IFS=$'\t' read -r id src name; do
    [ -n "$id" ] && [ -n "$(sync_dir "$src")" ] || continue
    if [ ! -f "state/$id/sync.env" ]; then
      warn "'$id' has no sync settings (state/$id/sync.env), so its sync isn't running"
      continue
    fi
    set_env "state/$id/sync.env" STACK_ID "$STACK_ID"
    case "$src" in
      livesync) ensure_couchdb; worker_configured "$id" || import_server_uri "$id"
        step "Sync for '$id' ${C_DIM}($(source_label "$src"))${C_0}" vc "$id" "$src" --progress plain up -d ;;
      livesync-existing) ensure_livesync_network
        step "Sync for '$id' ${C_DIM}($(source_label "$src"))${C_0}" vc "$id" "$src" --progress plain up -d ;;
      *) step "Sync for '$id' ${C_DIM}($(source_label "$src"))${C_0}" vc "$id" "$src" --progress plain up -d --build ;;
    esac || warn "Sync for '$id' didn't start; see above"
  done <<< "$(reg list)"
  for id in $(reg apps); do
    [ -f "state/$id/app.env" ] || continue
    # recreated, not just started: server.py is mounted as a single file, and
    # a git pull replaces it, which a running container wouldn't see
    step "Obsidian app for '$id'" ac "$id" --progress plain up -d --remove-orphans --force-recreate \
      || warn "The Obsidian app for '$id' didn't start; see above"
  done
  if manager_on; then
    step "Manager" mc --progress plain up -d --build --force-recreate || warn "The manager didn't start; see above"
  fi
}

# --- Obsidian app add-on (extras/obsidian-app) -------------------------------
#
# Optional, per vault: the full Obsidian desktop app in a browser tab, plus a
# small service through which obsidian-mcp runs Obsidian commands and manages
# community plugins via the official Obsidian CLI. The app opens the vault
# folder and doesn't sync; the vault's own sync keeps the folder current.

ac() {
  local id="$1"; shift
  docker compose -p "${P}obsidian-${id}-app" --project-directory extras/obsidian-app \
    -f extras/obsidian-app/docker-compose.yml --env-file "state/$id/app.env" "$@"
}

app_on() { reg apps | grep -qx "$1"; }

# obsidian <args> in the vault's app, through the CLI service's guard
app_cli() {
  local id="$1"; shift
  docker exec -u 1000:1000 "${P}obsidian-${id}-app" /lsiopy/bin/python3 /cli/server.py run "$@"
}

app_env() { grep "^$2=" "state/$1/app.env" 2>/dev/null | cut -d= -f2- | tr -d '"'; }

next_app_port() {
  local port=7300 used
  # ports this install's apps use, ports any container publishes (seen from
  # the manager add-on too, unlike ss), and ports host processes listen on
  used="$(cat state/*/app.env 2>/dev/null | sed -n 's/^APP_PORT="\{0,1\}\([0-9]*\).*/\1/p'
          docker ps --format '{{.Ports}}' 2>/dev/null | grep -oE ':[0-9]+->' | sed 's/[^0-9]//g'
          ss -ltn 2>/dev/null | awk 'NR > 1 {print $4}' | sed 's/.*://')"
  while grep -qx "$port" <<< "$used"; do
    port=$((port + 1))
  done
  echo "$port"
}

vault_src() { reg list | awk -F'\t' -v i="$1" '$1==i { print $2 }'; }

app_enable() {
  local id="${1:-}" f port ans token_new="" cfg _
  [ -n "$id" ] || { interactive_only "which vault: give its id"; vault_rows; echo; ask "  Vault id: " id; }
  [ -n "$(vault_src "$id")" ] || die "no vault '$id'"
  say "Setting up the Obsidian app for '$id'"
  info "It opens vaults/$id/ and doesn't sync by itself; the vault's own sync keeps it current."

  # one token for every app in this install, shared with obsidian-mcp
  if [ -z "${OBSIDIAN_APP_TOKEN:-}" ]; then
    set_env .env OBSIDIAN_APP_TOKEN "$(openssl rand -hex 32)"
    load_env; token_new=1
    ok "Generated the app token (OBSIDIAN_APP_TOKEN)"
  fi
  # the core network must have its fixed name (installs from before the
  # add-on get it here); recreating obsidian-mcp also picks up the token
  if [ -n "$token_new" ] || ! docker network inspect "${P}obsidian-internal" >/dev/null 2>&1; then
    step "Updating obsidian-mcp for the app" docker compose --progress plain up -d \
      || die "couldn't restart the core stack (try: $ME update)"
  fi

  f="state/$id/app.env"
  mkdir -p "state/$id/app/.config/obsidian"
  [ -f "$f" ] || { : > "$f"; chmod 600 "$f"; }
  set_env "$f" INSTANCE_PREFIX "$P" force
  set_env "$f" STACK_ID "$STACK_ID" force
  set_env "$f" VAULT_ID "$id" force
  set_env "$f" VAULT_DIR "$ROOT/vaults/$id" force
  set_env "$f" STATE_DIR "$ROOT/state/$id" force
  set_env "$f" OBSIDIAN_APP_TOKEN "$OBSIDIAN_APP_TOKEN" force
  set_env "$f" TZ "${OBSIDIAN_TIMEZONE:-UTC}"
  set_env "$f" APP_USER obsidian
  set_env "$f" APP_COMMANDS "*"
  set_env "$f" APP_EXTENSIONS manage
  set_env "$f" APP_SCREENSHOT_SIZE "1600x1000@2"
  if [ -z "$(app_env "$id" APP_PASSWORD)" ]; then set_env "$f" APP_PASSWORD "$(openssl rand -hex 12)"; fi
  if [ -z "$(app_env "$id" APP_PORT)" ]; then
    port="$(next_app_port)"
    ask "Port for the browser UI, on localhost [$port]: " ans app-port
    set_env "$f" APP_PORT "${ans:-$port}" force
  fi

  # Open the vault on first start, with the CLI switched on: the same two
  # settings Obsidian's own vault picker and Settings toggle write.
  cfg="state/$id/app/.config/obsidian/obsidian.json"
  [ -f "$cfg" ] || printf '{"vaults":{"%s":{"path":"/vault","ts":%s000,"open":true}},"cli":true}\n' "$id" "$(date +%s)" > "$cfg"
  own -R "state/$id/app"

  # git sync would otherwise commit the app's open-tabs state every minute
  if [ -d "vaults/$id/.git/info" ] && ! grep -qx '.obsidian/workspace.json' "vaults/$id/.git/info/exclude" 2>/dev/null; then
    printf '%s\n' .obsidian/workspace.json .obsidian/workspace-mobile.json >> "vaults/$id/.git/info/exclude"
  fi

  # Official Sync can bring the devices' plugins and their settings along, so
  # the server's app runs the same plugins, configured the same way.
  if [ "$(vault_src "$id")" = official ] && [ -z "$(grep '^SYNC_CONFIGS=' "state/$id/sync.env" | cut -d= -f2- | tr -d '"')" ]; then
    para <<'EOF'
This vault uses Obsidian Sync, which can also sync settings: community
plugins and their settings, theme, hotkeys. With it on, the server's app
runs the same plugins as the other devices. It's two-way, like the notes:
plugin changes made here reach the other devices too.
EOF
    echo
    ask "Sync plugins and settings with the other devices? [y/N] " ans settings-sync
    case "$ans" in
      [yY]*)
        set_env "state/$id/sync.env" SYNC_CONFIGS "app,appearance,appearance-data,hotkey,core-plugin,core-plugin-data,community-plugin,community-plugin-data" force
        step "Restarting Obsidian Sync with settings sync" vc "$id" official --progress plain up -d --build \
          || die "couldn't restart the sync for '$id'"
        step "Downloading plugins and settings" until_ok 60 settings_synced "$id" || warn "Still syncing; it carries on in the background."
        ok "Settings sync is on ${C_DIM}($(ls "vaults/$id/.obsidian/plugins" 2>/dev/null | wc -l | tr -d ' ') plugins here)${C_0}"
        echo
        ask "Let AI tools install, remove and change plugins (reaching every device)? [y/N] " ans plugin-changes
        case "$ans" in
          [yY]*) set_env "$f" APP_EXTENSIONS manage force ;;
          *) set_env "$f" APP_EXTENSIONS read force; info "Plugins are read-only for AI tools (APP_EXTENSIONS=read in $f)" ;;
        esac
        ;;
      *) set_env "state/$id/sync.env" SYNC_CONFIGS none force ;;
    esac
  fi

  pull "$(compose_image extras/obsidian-app/docker-compose.yml app)" "the Obsidian app"
  step "Starting the Obsidian app" ac "$id" --progress plain up -d --remove-orphans || die "the app didn't start"
  step "Waiting for Obsidian to open the vault" until_ok 90 app_healthy "$id" \
    || die "Obsidian didn't start — check: $ME logs app:$id"
  reg set-app "$id" on

  if [ "$(app_cli "$id" plugins:restrict 2>/dev/null)" = on ]; then
    para <<'EOF'
Obsidian starts vaults in restricted mode, where community plugins don't
run. Turning it off lets plugins in this vault's .obsidian folder, and any
installed by AI tools, run on this server.
EOF
    echo
    ask "Turn restricted mode off now? [y/N] " ans plugins
    case "$ans" in
      [yY]*) app_cli "$id" plugins:restrict off >/dev/null && ok "Restricted mode is off; community plugins can run" ;;
      *) info "Left on. Later: $ME app run $id plugins:restrict off" ;;
    esac
  fi
  app_show "$id"
}

app_healthy() { docker exec -u 1000:1000 "${P}obsidian-$1-app" /lsiopy/bin/python3 /cli/server.py health; }
settings_synced() { docker logs --since 2m "${P}obsidian-$1-official-sync" 2>&1 | grep -q 'Fully synced'; }

app_show() {
  local id="$1" port; port="$(app_env "$id" APP_PORT)"
  ok "The Obsidian app is running for '$id'"
  kv "Browser UI" "http://localhost:$port ${C_DIM}(this server only)${C_0}"
  kv "Login" "$(app_env "$id" APP_USER) ${C_DIM}/ APP_PASSWORD in state/$id/app.env${C_0}"
  kv "Elsewhere" "ssh -L $port:localhost:$port <this server>, then the same URL"
}

# kv "Label" "value" — an aligned detail line
kv() { printf '    %s%-14s%s %s\n' "$C_DIM" "$1" "$C_0" "$2"; }

app_disable() {
  local id="${1:-}"
  [ -n "$id" ] || { interactive_only "which vault: give its id"; ask "  Vault id: " id; }
  app_on "$id" || { info "The app isn't enabled for '$id'."; return; }
  [ -f "state/$id/app.env" ] && ac "$id" down -v --remove-orphans >/dev/null 2>&1 || true
  reg set-app "$id" off
  ok "Stopped the Obsidian app for '$id' ${C_DIM}(its settings stay in state/$id/app/)${C_0}"
}

cmd_app() {
  require_installed
  local sub="${1:-status}"; [ $# -gt 0 ] && shift
  case "$sub" in
    enable) app_enable "${1:-}" ;;
    disable) app_disable "${1:-}" ;;
    run)
      [ $# -ge 2 ] || die "usage: $ME app run <vault id> <obsidian cli command> [args]"
      app_on "$1" || die "the app isn't enabled for '$1'"
      local id="$1"; shift
      app_cli "$id" "$@"
      ;;
    status)
      local id any=""
      say "Obsidian app"
      for id in $(reg apps); do
        any=1
        printf '  %-20s %s\n' "$id" "$(dot "$(ours app "$id" | head -1)")"
        kv "Browser UI" "http://localhost:$(app_env "$id" APP_PORT)"
      done
      [ -n "$any" ] || info "No vault has the Obsidian app. Add it with: $ME app enable <vault id>"
      ;;
    *) die "usage: $ME app <status | enable [id] | disable [id] | run <id> <command...>>" ;;
  esac
}

# --- manager add-on (extras/manager) -------------------------------------------
#
# Optional: lets obsidian-mcp manage this install through a fixed list of
# operations, each an `obsidian-stack ... --yes` run. It holds the Docker
# socket (root-equivalent), so it's off unless turned on here. See
# docs/decisions/001-mcp-stack-management.md.

mc() {
  STACK_DIR="$ROOT" docker compose -p "${P}obsidian-manager" --project-directory extras/manager \
    -f extras/manager/docker-compose.yml --env-file .env "$@"
}

manager_on() { [ -n "${OBSIDIAN_MANAGER_TOKEN:-}" ]; }

manager_enable() {
  local ans
  say "Manager ${C_DIM}(lets AI tools manage this install)${C_0}"
  para <<EOF
With the manager on, AI tools connected to this MCP can add, rename and
remove vaults, restart sync, turn the Obsidian app on or off, and make
Setup URIs, through a fixed list of operations. They can't delete notes,
uninstall, update, or run anything else.

${C_WARN}Know before turning it on:${C_0}
- It runs obsidian-stack with access to Docker, which is root-equivalent on
  this server. Anyone holding the MCP's bearer token (or its OAuth login)
  gets these operations, so keep the MCP private or behind OAuth.
- Setup URIs and their passphrases are returned to the AI client, so they
  appear in that conversation.
- Official Sync vaults can only be added by reusing an account already
  signed in here; no Obsidian password goes through it.
EOF
  echo
  ask "Turn the manager on? [y/N] " ans confirm
  case "$ans" in [yY]*) ;; *) info "Left off."; return ;; esac

  if [ -z "${OBSIDIAN_MANAGER_TOKEN:-}" ]; then
    set_env .env OBSIDIAN_MANAGER_TOKEN "$(openssl rand -hex 32)" force
    ok "Generated the manager token (OBSIDIAN_MANAGER_TOKEN)"
  fi
  # installs from before the app token was made at install time
  [ -n "${OBSIDIAN_APP_TOKEN:-}" ] || set_env .env OBSIDIAN_APP_TOKEN "$(openssl rand -hex 32)" force
  load_env
  step "Updating obsidian-mcp for the manager" docker compose --progress plain up -d || die "couldn't restart the core stack"
  step "Building and starting the manager" mc --progress plain up -d --build || die "the manager didn't start"
  step "Checking the manager" until_ok 15 docker exec "${P}obsidian-manager" python3 /manager/manager.py health \
    || die "the manager isn't answering — check: docker logs ${P}obsidian-manager"
  ok "The manager is on. AI tools get the obsidian_stack_* tools on their next connection."
}

manager_disable() {
  manager_on || { info "The manager is off."; return; }
  step "Stopping the manager" mc down --remove-orphans || true
  set_env .env OBSIDIAN_MANAGER_TOKEN "" force
  load_env
  step "Updating obsidian-mcp" docker compose --progress plain up -d || die "couldn't restart the core stack"
  ok "The manager is off; AI tools no longer get the obsidian_stack_* tools."
}

cmd_manager() {
  require_installed
  case "${1:-status}" in
    enable|on) manager_enable ;;
    disable|off) manager_disable ;;
    status)
      say "Manager"
      if manager_on; then printf '  %-34s %s\n' "${P}obsidian-manager" "$(dot "$(ours manager | head -1)")"
      else info "Off. Turn on with: $ME manager enable"; fi ;;
    *) die "usage: $ME manager <status | enable | disable>" ;;
  esac
}

# --- machine-readable output (--json), for scripts and the manager add-on ----

json_str() { local v="${1//\\/\\\\}"; v="${v//\"/\\\"}"; v="${v//$'\n'/\\n}"; printf '"%s"' "$v"; }

# container state as JSON: {"name":...,"state":"running","health":"healthy"} or null
container_json() {
  local c="$1"
  [ -n "$c" ] || { printf 'null'; return; }
  printf '{"name":%s,"state":%s,"health":%s}' "$(json_str "$c")" \
    "$(json_str "$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo missing)")" \
    "$(json_str "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$c" 2>/dev/null || true)")"
}

vaults_json() {
  local id src name first=1 apps
  apps="$(reg apps)"
  printf '['
  while IFS=$'\t' read -r id src name; do
    [ -n "$id" ] || continue
    [ -n "$first" ] || printf ','; first=""
    printf '{"id":%s,"name":%s,"source":%s,"notes":%s,"sync":' "$(json_str "$id")" "$(json_str "$name")" \
      "$(json_str "$src")" "$(find "vaults/$id" -name '*.md' -not -path '*/.*' 2>/dev/null | wc -l | tr -d ' ')"
    if [ -n "$(sync_dir "$src")" ]; then container_json "$(ours sync "$id" | head -1)"; else printf 'null'; fi
    if grep -qx "$id" <<< "$apps"; then
      printf ',"app":{"enabled":true,"port":%s,"container":' "$(json_str "$(app_env "$id" APP_PORT)")"
      container_json "$(ours app "$id" | head -1)"; printf '}}'
    else
      printf ',"app":{"enabled":false}}'
    fi
  done <<< "$(reg list)"
  printf ']\n'
}

status_json() {
  local mcp=false
  curl -sf "$MCP_HEALTH" >/dev/null 2>&1 && mcp=true
  printf '{"folder":%s,"prefix":%s,"mcp":{"url":%s,"responding":%s},"core":{"api":' \
    "$(json_str "$ROOT")" "$(json_str "$P")" "$(json_str "http://localhost:${MCP_PORT:-7002}/mcp")" "$mcp"
  container_json "$(ours core | grep -x "${P}obsidian-api" || true)"; printf ',"mcp":'
  container_json "$(ours core | grep -x "${P}obsidian-mcp" || true)"; printf ',"couchdb":'
  container_json "$(ours couchdb | head -1)"; printf '},"vaults":'
  vaults_json
  printf '}\n'
}

cmd_rename() {
  require_installed
  local id="${1:-}"; shift || true
  local name="$*"
  [ -n "$id" ] && [ -n "$name" ] || die "usage: $ME rename <vault id> <new name>"
  reg rename "$id" "$name" || die "couldn't rename '$id'"
  ok "Renamed '$id' to '$name' ${C_DIM}(its id and folder stay the same)${C_0}"
}

# --- commands ----------------------------------------------------------------

cmd_install() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed. See https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 || die "docker compose (v2 plugin) is required."
  command -v openssl >/dev/null 2>&1 || die "openssl is required to generate secrets."
  command -v curl >/dev/null 2>&1 || die "curl is required."

  banner
  info "$ROOT${P:+  ·  prefix $P}"

  say "Configuration"
  if [ ! -f .env ]; then
    cp .env.example .env
    ok "Created .env"
  else
    ok "Using the existing .env"
  fi
  chmod 600 .env
  load_env
  if [ -z "${API_KEY:-}" ]; then set_env .env API_KEY "$(openssl rand -hex 32)"; ok "Generated the internal API key"; fi
  if [ -z "${MCP_BEARER_TOKEN:-}" ]; then set_env .env MCP_BEARER_TOKEN "$(openssl rand -hex 32)"; ok "Generated the MCP bearer token"; fi
  if [ -z "$STACK_ID" ]; then set_env .env STACK_ID "$(openssl rand -hex 8)"; ok "Generated this install's id ${C_DIM}(labels its containers)${C_0}"; fi
  # Made now rather than when the first app is enabled, so enabling one
  # never needs obsidian-mcp restarted (which, through the manager add-on,
  # would cut off the very request doing it).
  if [ -z "${OBSIDIAN_APP_TOKEN:-}" ]; then set_env .env OBSIDIAN_APP_TOKEN "$(openssl rand -hex 32)"; ok "Generated the Obsidian app token"; fi
  load_env

  # Catch a name collision before docker does. A container is ours if it
  # carries our STACK_ID label (or, from before labels, our compose project);
  # anything else with the same name belongs to something else.
  local foreign="" n owner project
  for n in "${P}obsidian-api" "${P}obsidian-mcp"; do
    docker inspect "$n" >/dev/null 2>&1 || continue
    owner="$(docker inspect -f "{{ index .Config.Labels \"$LABEL.id\" }}" "$n" 2>/dev/null || true)"
    project="$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$n" 2>/dev/null || true)"
    [ "$owner" = "$STACK_ID" ] || { [ -z "$owner" ] && [ "$project" = "${P}obsidian-server-stack" ]; } || foreign="$foreign $n"
  done
  if [ -n "$foreign" ]; then
    die "container name(s) already in use by something else on this machine:
$(echo "$foreign" | tr ' ' '\n' | sed '/^$/d;s/^/    /')
  Set INSTANCE_PREFIX in .env (e.g. INSTANCE_PREFIX=test-) to run a second,
  separate instance alongside the existing one, then re-run this script."
  fi

  # obsidian-api and every sync container run as uid/gid 1000. If the vault
  # folders end up owned by someone else (e.g. you ran this as root), every
  # write fails with EACCES. Found by actually testing this, not guessing.
  mkdir -p vaults state
  chmod 700 state
  own vaults

  say "Core services"
  step "Building obsidian-api and obsidian-mcp" docker compose --progress plain build \
    || die "the build failed (see above)"
  # --remove-orphans cleans up containers from older versions of this stack.
  step "Starting obsidian-api and obsidian-mcp" docker compose --progress plain up -d --remove-orphans \
    || die "they didn't start (see above)"
  # the core network had a generated name before it got a fixed one
  docker network rm "${P}obsidian-server-stack_obsidian-net" >/dev/null 2>&1 || true
  reg init
  step "Waiting for the MCP server" until_ok 30 curl -sf "http://localhost:${MCP_PORT:-7002}/health" \
    || die "obsidian-mcp didn't come up — check: $ME logs mcp"

  if [ -n "$(reg list)" ]; then
    say "Vaults"
    ensure_all_up
  else
    add_vault
  fi
  [ -t 0 ] && offer_link
  summary
  cmd_menu
}

# The end of an install: where things are and what to do next.
summary() {
  local token="${MCP_BEARER_TOKEN:-}"
  say "Ready"
  kv "MCP endpoint" "http://localhost:${MCP_PORT:-7002}/mcp"
  kv "Bearer token" "${token:0:6}… ${C_DIM}(full: $ME endpoint --show-token)${C_0}"
  kv "Vaults" "$(reg list | cut -f1 | paste -sd ' ' -)"
  kv "Manage" "$ME ${C_DIM}(menu)  ·  $ME help${C_0}"
  info "The MCP listens on localhost only; README.md lists ways to reach it from elsewhere."
}

offer_link() {
  local name; name="$(default_link_name)"
  [ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" = "$ROOT/obsidian-stack" ] && return 0
  [ -z "$NONINTERACTIVE" ] || return 0
  echo
  ask "Add an '$name' command to manage this install from anywhere? [Y/n] " ans
  case "${ans:-y}" in [nN]*) ;; *) cmd_link "$name" || true ;; esac
}

default_link_name() {
  # A second install (with a prefix) gets its own command name.
  if [ -n "$P" ]; then echo "obsidian-stack-${P%-}"; else echo obsidian-stack; fi
}

cmd_link() {
  load_env
  local name="${1:-$(default_link_name)}" target
  target="/usr/local/bin/$name"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ "$(readlink -f "$target")" = "$ROOT/obsidian-stack" ]; then ok "$name already points here"; return 0; fi
    die "$target already exists and points elsewhere. Pick another name: $ME link <name>"
  fi
  ln -s "$ROOT/obsidian-stack" "$target" 2>/dev/null || die "couldn't write $target (try with sudo)"
  ok "Added the '$name' command"
}

# vault_rows [counts] — one line per vault: id, name, source, sync state
# (and, with "counts", how many notes are on disk)
vault_rows() {
  local lines id src name state extra=""
  lines="$(reg list)"
  [ -n "$lines" ] || { info "No vaults yet"; return; }
  while IFS=$'\t' read -r id src name; do
    if [ -z "$(sync_dir "$src")" ]; then state="${C_DIM}○ no sync${C_0}"
    else state="$(dot "$(ours sync "$id" | head -1)")"; fi
    [ "${1:-}" = counts ] && extra="$(printf '%6s notes  ' "$(find "vaults/$id" -name '*.md' -not -path '*/.*' 2>/dev/null | wc -l | tr -d ' ')")"
    printf '  %-20s %-20s %-22s %s%s\n' "$id" "$name" "$(source_label "$src")" "$extra" "$state"
  done <<< "$lines"
}

cmd_status() {
  require_installed
  [ -n "$JSON" ] && { status_json; return; }
  say "obsidian-server-stack"
  local mcp_state
  if curl -sf "$MCP_HEALTH" >/dev/null 2>&1; then mcp_state="${C_OK}● responding${C_0}"; else mcp_state="${C_ERR}● not responding${C_0}"; fi
  kv "Folder" "$ROOT"
  kv "Prefix" "${P:-(none)}  ${C_DIM}·  install id $STACK_ID${C_0}"
  kv "MCP" "http://localhost:${MCP_PORT:-7002}/mcp  $mcp_state"

  say "Core"
  local c
  for c in "${P}obsidian-api" "${P}obsidian-mcp"; do
    printf '  %-34s %s\n' "$c" "$(dot "$(ours core | grep -x "$c" || true)")"
  done
  c="$(ours couchdb | head -1)"
  [ -n "$c" ] && printf '  %-34s %s\n' "$c" "$(dot "$c")"
  c="$(ours manager | head -1)"
  [ -n "$c" ] && printf '  %-34s %s\n' "$c" "$(dot "$c")"

  say "Vaults"
  vault_rows counts
  local a
  for a in $(reg apps); do
    printf '  %-20s %-43s %s\n' "$a" "Obsidian app on localhost:$(app_env "$a" APP_PORT)" "$(dot "$(ours app "$a" | head -1)")"
  done

  # containers labelled as ours whose vault is no longer in the registry
  local known orphan v
  known="$(reg list | cut -f1)"
  for orphan in $(docker ps -a --filter "label=$LABEL.id=$STACK_ID" --filter "label=$LABEL.role=sync" --format '{{.Names}}'); do
    v="$(docker inspect -f "{{ index .Config.Labels \"$LABEL.vault\" }}" "$orphan")"
    grep -qx "$v" <<< "$known" || warn "$orphan belongs to removed vault '$v' (remove with: docker rm -f $orphan)"
  done
}

# Container for a logs/restart target: a vault id, or api | mcp | couchdb
target_container() {
  case "$1" in
    api) ours core | grep -x "${P}obsidian-api" || true ;;
    mcp) ours core | grep -x "${P}obsidian-mcp" || true ;;
    couchdb) ours couchdb | head -1 ;;
    app:*) ours app "${1#app:}" | head -1 ;;
    *) ours sync "$1" | head -1 ;;
  esac
}

cmd_logs() {
  require_installed
  local target="${1:-}" follow="" c src
  [ -n "$target" ] || die "usage: $ME logs <vault id | app:<id> | api | mcp | couchdb> [-f]"
  [ "${2:-}" = "-f" ] && follow="-f"
  src="$(reg list | awk -F'\t' -v i="$target" '$1==i { print $2 }')"
  if [ "$src" = none ]; then echo "  '$target' has no sync, so there are no sync logs."; return; fi
  c="$(target_container "$target")"
  [ -n "$c" ] || die "nothing running for '$target' (vault ids: $(reg list | cut -f1 | tr '\n' ' '))"
  docker logs --tail "${PRESET[tail]:-100}" $follow "$c" 2>&1
}

cmd_restart() {
  require_installed
  local target="${1:-}" src id name
  [ -n "$target" ] || die "usage: $ME restart <vault id | api | mcp | couchdb | all>"
  case "$target" in
    api) docker compose restart obsidian-api >/dev/null 2>&1; ok "Restarted obsidian-api" ;;
    mcp) docker compose restart obsidian-mcp >/dev/null 2>&1; ok "Restarted obsidian-mcp" ;;
    couchdb) ( cd sync/couchdb && docker compose restart couchdb >/dev/null 2>&1 ); ok "Restarted CouchDB" ;;
    app:*)
      app_on "${target#app:}" || die "the app isn't enabled for '${target#app:}'"
      ac "${target#app:}" restart >/dev/null 2>&1; ok "Restarted the Obsidian app for '${target#app:}'" ;;
    all)
      docker compose restart >/dev/null 2>&1; ok "Restarted obsidian-api and obsidian-mcp"
      [ -n "$(ours couchdb)" ] && { ( cd sync/couchdb && docker compose restart couchdb >/dev/null 2>&1 ); ok "Restarted CouchDB"; }
      while IFS=$'\t' read -r id src name; do
        [ -n "$id" ] && [ -n "$(sync_dir "$src")" ] && [ -f "state/$id/sync.env" ] || continue
        vc "$id" "$src" restart >/dev/null 2>&1; ok "Restarted sync for '$id'"
      done <<< "$(reg list)"
      ;;
    *)
      src="$(reg list | awk -F'\t' -v i="$target" '$1==i { print $2 }')"
      [ -n "$src" ] || die "no vault '$target' (vault ids: $(reg list | cut -f1 | tr '\n' ' '))"
      [ -n "$(sync_dir "$src")" ] || { echo "  '$target' has no sync to restart."; return; }
      vc "$target" "$src" restart >/dev/null 2>&1
      ok "Restarted sync for '$target'"
      ;;
  esac
}

cmd_update() {
  require_installed
  say "Updating"
  if [ -d .git ]; then
    git pull --ff-only || die "git pull failed — resolve that, then run: $ME update"
  else
    warn "Not a git checkout, so nothing to pull; rebuilding what's here"
  fi
  # Re-running install rebuilds the images, recreates the core and brings
  # every vault's sync up on the new version. Skip its menu.
  OBSIDIAN_STACK_NO_MENU=1 cmd_install
}

cmd_uninstall() {
  load_env
  [ -n "$STACK_ID" ] || die "no STACK_ID in .env, so there's nothing labelled as this install's"
  local yes="$NONINTERACTIVE" ans id src name c link

  say "Uninstall ($ROOT)"
  info "Removes everything labelled obsidian-server-stack.id=$STACK_ID:"
  docker ps -a --filter "label=$LABEL.id=$STACK_ID" --format '{{.Names}}' | sort | sed 's/^/    /'
  info "Plus its networks, built images and obsidian-stack command. Notes, settings and .env"
  info "Are kept unless you choose otherwise."
  if [ -z "$yes" ]; then
    echo
    ask "Continue? [y/N] " ans
    case "$ans" in [yY]*) ;; *) info "Nothing removed."; return ;; esac
  fi

  # each vault's sync, including its local sync database volume, and any
  # Obsidian app add-ons
  if docker image inspect "${P}obsidian-api:local" >/dev/null 2>&1; then
    for id in $(reg apps 2>/dev/null); do
      [ -f "state/$id/app.env" ] && ac "$id" down -v --remove-orphans >/dev/null 2>&1 && ok "Removed the Obsidian app for '$id'"
    done
    while IFS=$'\t' read -r id src name; do
      [ -n "$id" ] || continue
      if [ -n "$(sync_dir "$src")" ] && [ -f "state/$id/sync.env" ]; then
        vc "$id" "$src" down -v --remove-orphans >/dev/null 2>&1 && ok "Removed sync for '$id'"
      fi
      # volumes `down -v` misses: ones from an older version of a compose file
      for project in "${P}obsidian-$id" "${P}obsidian-$id-app"; do
        docker volume ls -q --filter "label=com.docker.compose.project=$project" | xargs -r docker volume rm >/dev/null 2>&1 || true
      done
    done <<< "$(reg list 2>/dev/null)"
  fi

  # the shared CouchDB: its databases are the only copy on this server of
  # the LiveSync vaults, so they're kept unless asked
  if [ -f sync/couchdb/.env ] && [ -n "$(ours couchdb)$(ours couchdb-init)" ]; then
    ans=""
    [ -z "$yes" ] && ask "Also delete the CouchDB databases? Devices keep their own copies. [y/N] " ans
    case "$ans" in
      [yY]*) ( cd sync/couchdb && docker compose down -v >/dev/null 2>&1 ); ok "Removed CouchDB and its databases" ;;
      *) ( cd sync/couchdb && docker compose down >/dev/null 2>&1 ); ok "Removed CouchDB (databases kept in its Docker volume)" ;;
    esac
  fi

  docker compose down --rmi local --remove-orphans >/dev/null 2>&1 && ok "Removed obsidian-api and obsidian-mcp"

  # anything still labelled as ours (e.g. sync for a vault whose settings
  # were deleted by hand)
  for c in $(docker ps -aq --filter "label=$LABEL.id=$STACK_ID"); do
    docker rm -f "$c" >/dev/null && ok "Removed leftover container $c"
  done
  docker network rm "${P}obsidian-livesync" >/dev/null 2>&1 && ok "Removed network ${P}obsidian-livesync"
  docker volume rm "${P}obsidian-deno-cache" >/dev/null 2>&1 || true
  docker rmi "${P}obsidian-official-sync:local" "${P}obsidian-git-sync:local" "${P}obsidian-manager:local" >/dev/null 2>&1 || true

  for link in /usr/local/bin/*; do
    [ -L "$link" ] && [ "$(readlink -f "$link")" = "$ROOT/obsidian-stack" ] || continue
    rm -f "$link" 2>/dev/null && ok "Removed command $(basename "$link")"
  done

  if [ -z "$yes" ]; then
    echo
    info "Notes are still in $ROOT/vaults/ (sync settings in state/, secrets in .env)."
    ask "Type 'delete' to delete those too, or press Enter to keep them: " ans
    if [ "$ans" = delete ]; then
      rm -rf vaults state .env sync/couchdb/.env
      ok "Deleted vaults/, state/ and .env"
    else
      ok "Kept vaults/, state/ and .env"
    fi
  fi
  say "Uninstalled"
}


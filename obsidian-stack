cmd_endpoint() {
  require_installed
  say "MCP endpoint"
  kv "URL" "http://localhost:${MCP_PORT:-7002}/mcp"
  if [ "${1:-}" = "--show-token" ]; then
    kv "Bearer token" "${MCP_BEARER_TOKEN}"
  else
    kv "Bearer token" "${MCP_BEARER_TOKEN:0:6}… ${C_DIM}(full: $ME endpoint --show-token)${C_0}"
  fi
  kv "Header" "Authorization: Bearer <token>"
}

cmd_menu() {
  [ -n "${OBSIDIAN_STACK_NO_MENU:-}${NONINTERACTIVE}" ] && return 0
  require_installed
  local choice target
  while :; do
    say "Vaults ${C_DIM}$ROOT${C_0}"
    vault_rows
    local k="$C_ACC" z="$C_0"
    printf '\n  %sa%s add   %sr%s remove   %ss%s status   %sl%s logs   %sR%s restart   %se%s endpoint\n' "$k" "$z" "$k" "$z" "$k" "$z" "$k" "$z" "$k" "$z" "$k" "$z"
    printf '  %so%s Obsidian app   %sU%s setup URI   %sL%s licences   %su%s update   %sq%s quit\n\n' "$k" "$z" "$k" "$z" "$k" "$z" "$k" "$z" "$k" "$z"
    ask "Choose: " choice
    case "$choice" in
      a) add_vault ;;
      r) remove_vault ;;
      s) cmd_status ;;
      l) ask "Logs for (vault id, app:<id>, api, mcp, couchdb): " target; [ -n "$target" ] && { cmd_logs "$target" || true; } ;;
      R) ask "Restart (vault id, app:<id>, api, mcp, couchdb, all): " target; [ -n "$target" ] && { cmd_restart "$target" || true; } ;;
      e) cmd_endpoint ;;
      o) cmd_app status; echo; ask "Turn the app on or off for (vault id, blank to skip): " target
         if [ -n "$target" ]; then
           if app_on "$target"; then ( app_disable "$target" ) || true; else ( app_enable "$target" ) || true; fi
         fi ;;
      U) ask "Setup URI for (vault id): " target; [ -n "$target" ] && { ( cmd_setup_uri "$target" ) || true; } ;;
      L) cmd_licenses ;;
      u) cmd_update; return ;;
      q|Q|"") break ;;
      *) warn "'$choice' isn't an option" ;;
    esac
  done
  echo
}


# parse_opts ARGS... — options that answer questions become PRESET entries;
# everything else is left in ARGS for the command.
ARGS=()
CHANGE_URL=""
parse_opts() {
  local key val
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) NONINTERACTIVE=1; PRESET[confirm]=y ;;
      --json) JSON=1 ;;
      --name|--source|--device-url|--app|--app-port|--plugins|--settings-sync|--plugin-changes|--git-repo|--official-vault|--reuse-login|--tail)
        [ $# -ge 2 ] || die "$1 needs a value"
        key="${1#--}"; val="$2"
        case "$key" in
          app|plugins|settings-sync|plugin-changes|reuse-login)
            case "${val,,}" in
              y|yes|on|true|1) val=y ;;
              n|no|off|false|0) val=n ;;
              *) die "$1 takes yes or no" ;;
            esac ;;
        esac
        PRESET[$key]="$val"; shift ;;
      --url)
        CHANGE_URL=1
        if [ $# -ge 2 ] && [[ "$2" != --* ]]; then PRESET[device-url]="$2"; shift; fi ;;
      --) shift; ARGS+=("$@"); break ;;
      *) ARGS+=("$1") ;;
    esac
    shift
  done
}

load_env
parse_opts "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
cmd="${1:-menu}"
[ $# -gt 0 ] && shift
case "$cmd" in
  install) cmd_install ;;
  menu) cmd_menu ;;
  status) cmd_status ;;
  vaults|list) require_installed; if [ -n "$JSON" ]; then vaults_json; else vault_rows; fi ;;
  rename) cmd_rename "$@" ;;
  manager) cmd_manager "$@" ;;
  add) require_installed; add_vault ;;
  remove|rm) require_installed; remove_vault "${1:-}" ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  update) cmd_update ;;
  uninstall) cmd_uninstall "$@" ;;
  endpoint) cmd_endpoint "$@" ;;
  setup-uri) cmd_setup_uri "$@" ;;
  licenses|licences|license|licence|notices) cmd_licenses "$@" ;;
  app) cmd_app "$@" ;;
  link) cmd_link "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac

# Copy to .env and fill in. Never commit .env.
# The install.sh script generates the random values for you.

# Running more than one copy of this stack on the same machine (e.g.
# testing this alongside an existing install)? Give this one a prefix so
# its containers/volumes/network don't collide with the other's — e.g.
# INSTANCE_PREFIX=test- turns "obsidian-api" into "test-obsidian-api".
# Leave blank for the default names. If you use this, also set it (with
# the same value) in sync/official-obsidian-sync/.env and
# sync/self-hosted-livesync/.env — each is a separate compose project
# with its own .env, so it isn't inherited automatically.
INSTANCE_PREFIX=

# Where your vault's markdown files live on this machine.
VAULT_HOST_PATH=./vault

# Shared secret between obsidian-mcp and obsidian-api (internal only).
# Generate with: openssl rand -hex 32
API_KEY=

# What MCP clients authenticate to the MCP with.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional
OBSIDIAN_DAILY_FOLDER=Journal
OBSIDIAN_TIMEZONE=UTC
OBSIDIAN_MAX_ATTACHMENT_BYTES=10485760

# Port (change if it collides with something else on your machine)
MCP_PORT=7002

# Optional OAuth login, for MCP clients that sign in through an OAuth 2.1
# provider (Authentik, Keycloak, etc.) instead of taking a bearer token.
# The bearer token above keeps working either way. Leave ISSUER blank to
# keep OAuth off.
MCP_OAUTH_ISSUER=
# The public URL clients use to reach the MCP, e.g. https://notes.example.com
MCP_OAUTH_CANONICAL_URL=
# Defaults to <issuer>/jwks/
MCP_OAUTH_JWKS_URI=
# Expected `aud` claim. Defaults to the canonical URL; some providers
# (Authentik) put the client ID here instead.
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_SCOPES=
